# ---- Required ---------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Powers the script, the voiceover, the hero images and the word timestamps.
#
# AI Studio now issues "auth keys" that start with AQ. — copy the key exactly as
# shown. Legacy AIza... keys are being retired (unrestricted ones were already
# rejected in June 2026, the format is being cut off entirely), so an AQ. key is
# the safe choice. Either format works with this engine: the key is sent in the
# x-goog-api-key header, never in a URL.
GEMINI_API_KEY=AQ.Ab...

# Telegram bot token from @BotFather (only needed to run the bot front-end).
TELEGRAM_BOT_TOKEN=123456:ABC...

# ---- Optional ---------------------------------------------------------------
# Override binary locations when they are not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Point HyperFrames at a specific browser build.
# HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium

# Cloudflare relay (see cloudflare-worker.js)
# TELEGRAM_WEBHOOK_SECRET=...
# ALLOWED_CHAT_IDS=123456789,987654321
# GITHUB_REPO=owner/repo
# GITHUB_REF=main

# Silence the CLI update check in CI
# HYPERFRAMES_NO_UPDATE_CHECK=1
